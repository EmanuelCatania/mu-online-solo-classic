end// Light Spear (vanilla 3,0): el 0.97 lo dibuja corrido en su casilla.
// CorrecciÃ³n del 5.2 (ZzzInventory.cpp, RenderObjectScreen MODEL_SPEAR+0):
// Position[1] += 0.05 y Ã¡ngulo (0, 90, 20).  Escala 0 = la vanilla.
{
  "item": "3,0",
  "inventory": { "position": [0.0, 0.05], "rotation": [0, 90, 20] }
}
// Pet Rudolph (13,400): ejemplo de pet custom.  Este archivo sÃ³lo define cÃ³mo
// se ve en el inventario (pose del 5.2, ZzzInventory.cpp MODEL_HELPER+67);
// el pet en sÃ­ estÃ¡ en Data/Custom/Pets/13_400.json.  "tooltip" agrega
// lÃ­neas propias debajo del nombre.
{
  "item": "13,400",
  "inventory": { "position": [0.0, -0.05], "rotation": [270, 40, 0], "scale": 0.0015 },
  "tooltip": [ { "text": "Zen picker", "color": "gold" } ]
}
// Pet Rudolph (13,400): da vueltas alrededor del dueÃ±o; cuando cae zen cerca
// vuela hasta Ã©l, da vueltas encima y lo levanta (el Collecter del 5.2).
// "delay" es lo que tarda en levantarlo desde que lo elige.
{
  "item": "13,400",
  "scale": 1.0,
  "blendMesh": 0,
  "movement": { "type": "orbit", "radius": 50, "period": 4000, "height": 20 },
  "abilities": [
    { "type": "pickup", "what": "zen", "range": 3, "interval": 1000, "delay": 1500 }
  ]
}
